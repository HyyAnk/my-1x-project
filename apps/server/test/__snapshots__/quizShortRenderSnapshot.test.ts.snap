ta-mascot-preview="false" data-mascot-visible="true" data-layout-ignore aria-hidden="true"><div class="mascot-v2-state state-thinking" style="--mascot-state-delay:0s;--mascot-state-span:6.45s;--mascot-pivot-x:110px;--mascot-pivot-y:220px;--mascot-frame-pivot-x:110px;--mascot-frame-pivot-y:220px;--mascot-pivot-compensation-x:0px;--mascot-pivot-compensation-y:0px;--mascot-registration-x:0px;--mascot-registration-y:0px;--mascot-content-bottom-gap:0px;--mascot-content-width:633.6px;--mascot-content-center-x:0px;--mascot-motion-preset:none;--mascot-motion-speed:1;--mascot-motion-intensity:normal;--mascot-motion-cycle:1s;--mascot-motion-delay:0s;--mascot-motion-iterations:1;--mascot-preview-transform:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-0:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-25:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-50:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-75:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-100:translate(0px,0px) rotate(0deg) scale(1,1)" data-legacy-class="mascot-state-layer" data-mascot-visible="true" data-mascot-playing="true" data-mascot-phase="thinking" data-mascot-action="thinking" data-mascot-asset-action="thinking" data-mascot-asset-url="file:///<drive>/assets/mascot_thinking_1.png" data-mascot-media-mode="static" data-mascot-motion-preset="none" data-mascot-motion-speed="1" data-mascot-motion-intensity="normal" data-mascot-registration-offset="0,0" data-mascot-enter-transition="none" data-mascot-exit-transition="fade" data-mascot-box="653.2,1286.4,633.6,633.6" data-mascot-pivot="970,1920" data-mascot-visible-bounds="653.2,1286.4,633.6,633.6"><div class="mascot-v2-enter enter-none" style="--mascot-enter-delay:0s"><div class="mascot-v2-motion motion-none" style="--mascot-motion-delay:0s"><img class="mascot-v2-frame mascot-v2-image" src="file:///<drive>/assets/mascot_thinking_1.png" alt="" style="--mascot-art-url:url('file:///<drive>/assets/m