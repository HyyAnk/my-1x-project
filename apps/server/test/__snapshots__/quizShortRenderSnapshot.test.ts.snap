l;base64,[inline]" alt="Jupiter with its great red spot"><span class="image-shine"></span></figure><div class="choice-group choice-group-text answer-grid answer-count-3" role="list" aria-label="Answer choices" data-choice-presentation="text" data-choice-visibility="hidden" data-choice-phase="question" data-choice-fit-status="pending" data-choice-fit-lines="1" aria-hidden="true"><div class="choice-card choice-card-text answer-card skin-glossy_arcade answer-normal answer-pending answer-reveal-correct choice-tier-short" style="--item-phase:2.709s" role="listitem" aria-label="A: Jupiter" data-choice-id="q1-c0" data-choice-order="0" data-choice-label="A" data-answer-state="pending" data-choice-skin="glossy_arcade" data-choice-variant="detached_badge" data-layout-allow-occlusion data-layout-allow-overflow><b class="choice-label" data-layout-allow-occlusion data-text="A" aria-hidden="true">A</b><div class="choice-card-surface ac-glossy-arcade" data-layout-allow-overflow><span class="choice-text" data-layout-allow-occlusion data-text="Jupiter">Jupiter</span></div></div><div class="choice-card choice-card-text answer-card skin-glossy_arcade answer-normal answer-pending answer-reveal-incorrect choice-tier-short" style="--item-phase:0.482s" role="listitem" aria-label="B: Mars" data-choice-id="q1-c1" data-choice-order="1" data-choice-label="B" data-answer-state="pending" data-choice-skin="glossy_arcade" data-choice-variant="detached_badge" data-layout-allow-occlusion data-layout-allow-overflow><b class="choice-label" data-layout-allow-occlusion data-text="B" aria-hidden="true">B</b><div class="choice-card-surface ac-glossy-arcade" data-layout-allow-overflow><span class="choice-text" data-layout-allow-occlusion data-text="Mars">Mars</span></div></div><div class="choice-card choice-card-text answer-card skin-glossy_arcade answer-normal answer-pending answer-reveal-incorrect choice-tier-short" style="--item-phase:1.856s" role="listitem" aria-label="C: Venus" data-choice-id="q1-c2"