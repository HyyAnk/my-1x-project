exports[`Quiz Short render snapshot > renders the kickoff card with the question count and the three second score CTA 1`] = `"<template id="candy-score-cta-template"><section id="candy-score-cta" class="clip candy-scene candy-score-cta-scene" style="--clip-start: 0s;--bg-primary:#FF82AF;--bg-secondary:#E94F8A;--accent:#FFD44D;" data-quiz-stage="score_cta" data-composition-id="candy-score-cta" data-no-timeline data-width="1080" data-height="1920" data-aspect-ratio="9:16"><div class="score-cta-rays" data-layout-ignore aria-hidden="true"></div><div class="score-cta-card" data-on-screen-copy="How many did you get right? Comment below"><h1 class="score-cta-headline">How many did you get right?</h1><p class="score-cta-prompt">Comment below</p><div class="score-cta-sparkles" data-layout-ignore aria-hidden="true">✦&nbsp;&nbsp;★&nbsp;&nbsp;✦</div></div><div class="candy-mascot-container mascot-v2-container mascot-stage anchor-bottom_right mascot-score-cta" style="--mascot-placement-offset-x:0px;--mascot-placement-offset-y:0px;--mascot-scale:2.88;--mascot-flip-sign:1" data-mascot-contract-version="2" data-mascot-aspect-ratio="9:16" data-mascot-canvas="1080x1920" data-mascot-anchor="bottom_right" data-mascot-scale="2.88" data-mascot-offset-x="0" data-mascot-offset-y="0" data-mascot-flip-x="false" data-mascot-preview="false" data-mascot-visible="true" data-layout-ignore aria-hidden="true"><div class="mascot-v2-state state-celebrate" style="--mascot-state-delay:0s;--mascot-state-span:3s;--mascot-pivot-x:110px;--mascot-pivot-y:220px;--mascot-frame-pivot-x:110px;--mascot-frame-pivot-y:220px;--mascot-pivot-compensation-x:0px;--mascot-pivot-compensation-y:0px;--mascot-registration-x:0px;--mascot-registration-y:0px;--mascot-content-bottom-gap:0px;--mascot-content-width:633.6px;--mascot-content-center-x:0px;--mascot-motion-preset:none;--mascot-motion-speed:1;--mascot-motion-intensity:normal;--mascot-motion-cycle:1s;--mascot-motion-delay:0s;--mascot-motion-iterations:1;--mascot-preview-transform:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-0:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-25:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-50:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-75:translate(0px,0px) rotate(0deg) scale(1,1);--mascot-motion-kf-100:translate(0px,0px) rotate(0deg) scale(1,1)" data-legacy-class="mascot-state-layer" data-mascot-visible="true" data-mascot-playing="true" data-mascot-phase="reveal" data-mascot-action="celebrate" data-mascot-asset-action="celebrate" data-mascot-asset-url="file:///<drive>/assets/mascot_celebrate_1.png" data-mascot-media-mode="static" data-mascot-motion-preset="none" data-mascot-motion-speed="1" data-mascot-motion-intensity="normal" data-mascot-registration-offset="0,0" data-mascot-enter-transition="pop" data-mascot-exit-transition="fade" data-mascot-box="653.2,1286.4,633.6,633.6" data-mascot-pivot="970,1920" data-mascot-visible-bounds="653.2,1286.4,633.6,633.6"><div class="mascot-reveal-fx" style="--mascot-fx-delay:0s" data-layout-ignore aria-hidden="true"><div class="mascot-fx-bloom"></div><div class="mascot-fx-ring ring-1"></div><div class="mascot-fx-ring ring-2"></div><span class="mascot-fx-sparkle sp-1">✦</span><span class="mascot-fx-sparkle sp-2">★</span><span class="mascot-fx-sparkle sp-3">✦</span><span class="mascot-fx-sparkle sp-4">★</span></div><div class="mascot-v2-enter enter-pop" style="--mascot-enter-delay:0s"><div class="mascot-v2-motion motion-none" style="--mascot-motion-delay:0s"><img class="mascot-v2-frame mascot-v2-image" src="file:///<drive>/assets/mascot_celebrate_1.png" alt="" style="--mascot-art-url:url('file:///<drive>/assets/mascot_celebrate_1.png')" data-mascot-image="file:///<drive>/assets/mascot_celebrate_1.png"></div></div></div></div></section></template>"`;

exports[`Quiz Short render snapshot > short_media_top_choices question clip matches its HTML snapshot 1`] = `"<template id="quiz-q1-1400-template"><section id="quiz-q1-1400" class="clip candy-scene quiz-question-clip quiz-first-question quiz-frame-unified quiz-frame-portrait quiz-short-question layout-short_media_top_choices archetype-multiple_choice motion-enter-pop has-mascot" style="--bg-primary:#99D93E;--bg-secondary:#31B87A;--bg-accent:#FF6C78;--accent:#FF6C78;--surface-accent:#C0394B;--on-accent:#0F172A;--answer-badge:#FF6C78;--badge:#FF6C78;--correct:#27B96C;--incorrect:#7B8DA1;--surface:#FFFDF7;--text:#152A57;--ink:#152A57;--muted:#E8F5DF;--question-size:60px;--question-leading:1.15;--clip-start: 0s;--timer-start:0.000s;--scene-duration:8.360s;--choices-at:0.300s;--thinking-at:2.900s;--reveal-at:6.450s;--reward-at:7.030s;--choices-duration:6.150s;--timer-duration:6.450s;--query-hold-duration:3.450s;--reveal-duration:0.580s;--ambient-phase:5.938s" data-reveal-at="6.450" data-composition-id="quiz-q1-1400" data-no-timeline data-width="1080" data-height="1920" data-aspect-ratio="9:16"><div class="quiz-scene-background" data-background-style="candy_rays" data-layout-ignore aria-hidden="true"><div class="bg-candy-rays"><div class="bg-gradient"></div><div class="bg-rays"></div><div class="bg-pattern pattern-circles"></div><div class="bg-pattern pattern-sprinkles"></div><div class="bg-shape shape-a" data-layout-allow-overflow></div><div class="scene-decor" data-layout-ignore aria-hidden="true"><i class="decor-1" data-layout-ignore aria-hidden="true" style="--decor-phase:5.938s">✦</i><i class="decor-2" data-layout-ignore aria-hidden="true" style="--decor-phase:1.979s">•</i><i class="decor-3" data-layout-ignore aria-hidden="true" style="--decor-phase:4.421s">○</i><i class="decor-4" data-layout-ignore aria-hidden="true" style="--decor-phase:0.462s">★</i><i class="decor-5" data-layout-ignore aria-hidden="true" style="--decor-phase:2.903s">✧</i><i class="decor-6" data-la